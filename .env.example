# База данных
POSTGRES_USER=afisha
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=afisha
DATABASE_URL=postgresql+asyncpg://afisha:change_me_in_production@db:5432/afisha

# Telegram (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# LLM провайдер: yandexgpt | gigachat | openai
LLM_PROVIDER=gigachat

# YandexGPT (через OpenAI-совместимый API)
# Получите IAM-токен: https://yandex.cloud/ru/docs/foundation-models/quickstart
YANDEXGPT_API_KEY=your_yandexgpt_api_key
YANDEXGPT_FOLDER_ID=your_folder_id
YANDEXGPT_BASE_URL=https://llm.api.cloud.yandex.net/v1
YANDEXGPT_MODEL=yandexgpt-lite

# GigaChat (альтернатива)
GIGACHAT_API_KEY=your_gigachat_key

# OpenAI (если есть)
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini

# Агент
AGENT_MAX_STEPS=5
AGENT_TIMEOUT_SEC=30

# Fallback
FALLBACK_TIMEOUT_SEC=5
RATE_LIMIT_PER_DAY=20

# App
ENV=development
LOG_LEVEL=INFO